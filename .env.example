# 环境变量样例
#
# 用法（PowerShell，无需额外依赖）：
#   $env:DJANGO_SECRET_KEY = "把下面生成的随机串粘进来"
#   $env:DJANGO_DEBUG = "0"
#   .\scripts\start.ps1 -PublicOrigin https://xxx.ngrok-free.dev
#
# 生成密钥：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---------------------------------------------------------------- 必填（生产）
# 生产模式（DJANGO_DEBUG=0）下必须提供；留空会导致启动即失败（check chat.E001）
DJANGO_SECRET_KEY=

# 1 = 开发模式（默认）；0 = 生产模式
DJANGO_DEBUG=1

# ---------------------------------------------------------------- 公网访问
# 经 ngrok / 反向代理访问时必填，否则登录会报 CSRF 403
# 多个来源用逗号分隔
DSH_PUBLIC_ORIGIN=
# 经 HTTPS 访问时设为 1，让 Cookie 带上 Secure 标记
DSH_PUBLIC_HTTPS=

# 生产模式下不允许通配符；开发模式会自动放开
ALLOWED_HOSTS=

# ---------------------------------------------------------------- 可选
# 事件存储后端：memory（一期默认）| redis（二期）
EVENT_STORE_BACKEND=memory
